{
  "parser": "babel-eslint",
  "extends": [
    "plugin:react/recommended",
    "plugin:prettier/recommended",
    "plugin:import/errors",
    "plugin:import/warnings",
    "plugin:sonarjs/recommended",
    // "plugin:consistent-default-export-name/fixed",
    "airbnb",
    "prettier"
  ],
  "plugins": ["import", "promise", "compat", "react", "prettier", "sonarjs"],
  "env": {
    "browser": true,
    "es6": true,
    "jest": true,
    "node": true
  },
  "globals": {
    "Atomics": "readonly",
    "SharedArrayBuffer": "readonly"
  },
  "parserOptions": {
    "ecmaFeatures": {
      "jsx": true
    },
    "ecmaVersion": 2018,
    "sourceType": "module"
  },
  "rules": {
    "arrow-body-style": [0, "as-needed"],
    "class-methods-use-this": 0,
    "import/imports-first": 0,
    "import/newline-after-import": 0,
    "import/no-dynamic-require": 0,
    "import/no-extraneous-dependencies": 0,
    "import/no-named-as-default": 0,
    "import/no-unresolved": 0,
    "import/no-webpack-loader-syntax": 0,
    "import/prefer-default-export": 0,
    "jsx-a11y/aria-props": 2,
    "jsx-a11y/heading-has-content": 0,
    "jsx-a11y/control-has-associated-label": 0,
    "jsx-a11y/label-has-associated-control": [
      2,
      {
        "controlComponents": ["Input"]
      }
    ],
    "jsx-a11y/label-has-for": 0,
    "jsx-a11y/mouse-events-have-key-events": 2,
    "jsx-a11y/role-has-required-aria-props": 2,
    "jsx-a11y/role-supports-aria-props": 2,
    "max-len": 0,
    "func-names": 0,
    "newline-per-chained-call": 2,
    "no-confusing-arrow": 0,
    "no-unneeded-ternary": 2,
    "no-unused-expressions": 0,
    "no-console": [
      2, { 
        "allow": ["warn", "error"] 
      }
    ],
    "no-unused-vars": 2,
    "no-alert": 2,
    "no-use-before-define": 0,
    "no-plusplus": 0,
    "no-continue": 1,
    "no-unreachable": 1,
    "vars-on-top": 2,
    "prefer-template": 2,
    "no-restricted-properties": 0,
    "no-return-await": 2,
    "no-useless-catch": 2,
    "no-delete-var": 2,
    "no-with": 2,
    "no-debugger": 2,
    "no-empty": 2,
    "no-param-reassign": 2,
    "no-extra-semi": 2,
    "no-restricted-syntax": 2,
    "no-constant-condition": 2,
    "no-duplicate-imports": 2,
    "no-useless-return": 2,
    "no-new-wrappers": 2,
    "camelcase": 2,
    "function-call-argument-newline": 2,
    "sonarjs/prefer-immediate-return": 2,
    "sonarjs/no-small-switch": 2,
    "sonarjs/prefer-while": 2,
    "sonarjs/no-inverted-boolean-check": 2,
    "sonarjs/prefer-single-boolean-return": 2,
    "sonarjs/cognitive-complexity": ["error", 50],
    "sonarjs/no-identical-expressions": 2,
    "sonarjs/no-ignored-return": 2,
    "sonarjs/no-collapsible-if": 1, // temporary 1 to review whole app
    "sonarjs/no-identical-functions": 0,
    "sonarjs/no-all-duplicated-branches": 0,
    "sonarjs/no-duplicate-string": 0,
    "sonarjs/no-duplicated-branches": 0,
    "sonarjs/no-nested-template-literals": 0,
    "sonarjs/no-empty-collection": 0,
    // "consistent-default-export-name/default-export-match-filename": "error",
    "react/no-unknown-property": 0,
    "react/no-danger": 0,
    "react/destructuring-assignment": 0,
    "react-hooks/rules-of-hooks": 0,
    "react/jsx-closing-tag-location": 0,
    "react/forbid-prop-types": 0,
    "react/jsx-first-prop-new-line": [2, "multiline"],
    "react/jsx-filename-extension": 0,
    "react/jsx-no-target-blank": 0,
    "react/jsx-uses-vars": 2,
    "react/require-default-props": 0,
    "react/require-extension": 0,
    "react/self-closing-comp": 0,
    "react/sort-comp": 0,
    "react/no-access-state-in-setstate": 0,
    "import/named": 0,
    "import/extensions": 0,
    "import/order": 0,
    "import/no-self-import": 0,
    "import/no-duplicates": 0,
    "import/no-cycle": 0,
    "import/no-useless-path-segments": 0,
    "import/no-named-as-default-member": 0,
    "react/jsx-curly-brace-presence": 0,
    "react/jsx-props-no-spreading": 0,
    "prettier/prettier": [
      "error",
      {
        "endOfLine": "auto"
      }
    ]
  },
  "settings": {
    "import/resolver": {
      "alias": {
        "extensions": [".ts", ".js", ".jsx", ".json"]
      }
    }
  }
}